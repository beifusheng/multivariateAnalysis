{
  "name": "multivariateAnalysis",
  "version": "1.0.0",
  "description": "多变量统计分析桌面端（PERMANOVA / 中介 / 受限置换 / GMR⁴ / Bayesian ERA）",
  "main": "./public/electron/main.js",
  "scripts": {
    "dev": "ee-bin dev",
    "setup": "node r-scripts/tools/install_deps.mjs",
    "setup:js": "node r-scripts/tools/install_deps.mjs",
    "setup:js:frozen": "node r-scripts/tools/install_deps.mjs --frozen",
    "setup:r": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-r-runtime.ps1",
    "setup:r:repos": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-r-runtime.ps1 -Mode fromRepos",
    "setup:r:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-r-runtime.ps1 -Mode verify",
    "verify:env": "node r-scripts/tools/check_env.mjs",
    "verify": "node r-scripts/tools/run_all_tests.mjs",
    "verify:js": "node r-scripts/tools/run_all_tests.mjs --node",
    "verify:r": "node r-scripts/tools/run_all_tests.mjs --r",
    "verify:one": "node r-scripts/tools/run_all_tests.mjs --only",
    "lock:r": "r-portable/bin/Rscript.exe r-scripts/tools/export_r_lockfile.R",
    "build": "npm run build-frontend && npm run build-electron && ee-bin encrypt",
    "start": "ee-bin start",
    "dev-frontend": "ee-bin dev --serve=frontend",
    "dev-electron": "ee-bin dev --serve=electron",
    "build-frontend": "ee-bin build --cmds=frontend && ee-bin move --flag=frontend_dist",
    "build-electron": "ee-bin build --cmds=electron",
    "icon": "ee-bin icon",
    "re-sqlite": "electron-rebuild -f -w better-sqlite3",
    "build-w": "npm run build && ee-bin build --cmds=win64",
    "build-w:offline": "npm run build && electron-builder --win --x64 --dir -c cmd/builder.json -c.electronDist=node_modules/electron/dist",
    "build-we": "ee-bin build --cmds=win_e",
    "build-m": "npm run build && ee-bin build --cmds=mac_arm64",
    "build-m-x86": "npm run build && ee-bin build --cmds=mac",
    "build-m-arm64": "ee-bin build --cmds=mac_arm64",
    "build-l": "npm run build && ee-bin build --cmds=linux"
  },
  "repository": "https://github.com/dromara/electron-egg.git",
  "keywords": [
    "Electron",
    "electron-egg",
    "ElectronEgg"
  ],
  "author": "北符生",
  "designFor": "澜芸",
  "license": "Apache",
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/node": "^22.19.1",
    "debug": "^4.4.0",
    "ee-bin": "^5.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.3.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ee-core": "^5.0.1",
    "electron-updater": "^6.7.3",
    "tree-kill": "^1.2.2"
  }
}
