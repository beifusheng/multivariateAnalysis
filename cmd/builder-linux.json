{
  "productName": "multivariateAnalysis",
  "appId": "com.beifusheng.multivariateAnalysis",
  "copyright": "© 2026 multivariateAnalysis",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "asarUnpack": [
    "r-scripts/**/*"
  ],
  "electronLanguages": [
    "en-US",
    "zh-CN"
  ],
  "files": [
    "public",
    "package.json",
    "node_modules/**/*",
    "r-scripts/**/*"
  ],
  "extraResources": [
    {
      "from": "build/extraResources",
      "to": "extraResources"
    },
    {
      "from": "r-portable",
      "to": "extraResources/r-portable"
    }
  ],
  "publish": [
    {
      "provider": "generic",
      "url": ""
    }
  ],
  "linux": {
    "icon": "build/icons/icon.icns",
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "target": [
      "deb"
    ],
    "category": "Utility"
  }
}
